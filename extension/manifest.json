{
    "manifest_version": 3,
    "name": "Algo Coach",
    "version": "1.0.0",
    "description": "A VS Code extension for algorithm coaching.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Algo Coach"
    },
    "host_permissions": [
        "http://localhost:8080/*",
        "https://leetcode.cn/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.cn/problems/*"
            ],
            "js": [
                "content/content-leetcode-cn.js"
            ],
            "run_at": "document_idle"
        }
    ]
}