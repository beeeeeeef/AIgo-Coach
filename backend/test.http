### 1) 新建多轮对话
# @name chat1
POST http://localhost:8080/api/chat
Content-Type: application/json

{
  "conversationId": null,
  "message": "请先看看我的代码，指出主要问题和下一步思考方向。",
  "context": {
    "site": "leetcode-cn",
    "title": "两数之和",
    "url": "https://leetcode.cn/problems/two-sum/",
    "description": "给定一个整数数组 nums 和一个整数目标值 target，请你在该数组中找出和为目标值 target 的那两个整数，并返回它们的数组下标。",
    "language": "cpp",
    "code": "class Solution {\npublic:\n    vector<int> twoSum(vector<int>& nums, int target) {\n        for (int i = 0; i < nums.size(); i++) {\n            for (int j = i + 1; j < nums.size(); j++) {\n                if (nums[i] + nums[j] == target) {\n                    return {i, j};\n                }\n            }\n        }\n        return {};\n    }\n};"
  }
}

### 2) 续聊（把上一轮返回的 conversationId 填到下面）
POST http://localhost:8080/api/chat
Content-Type: application/json

{
  "conversationId": 1,
  "message": "哈希表应该存什么？",
  "context": {
    "site": "leetcode-cn",
    "title": "两数之和",
    "url": "https://leetcode.cn/problems/two-sum/",
    "description": "给定一个整数数组 nums 和一个整数目标值 target，请你在该数组中找出和为目标值 target 的那两个整数，并返回它们的数组下标。",
    "language": "cpp",
    "code": "class Solution {\npublic:\n    vector<int> twoSum(vector<int>& nums, int target) {\n        for (int i = 0; i < nums.size(); i++) {\n            for (int j = i + 1; j < nums.size(); j++) {\n                if (nums[i] + nums[j] == target) {\n                    return {i, j};\n                }\n            }\n        }\n        return {};\n    }\n};"
  }
}

### 调试：旧 analyze 接口
POST http://localhost:8080/api/analyze
Content-Type: application/json

{
  "site": "leetcode-cn",
  "title": "两数之和",
  "url": "https://leetcode.cn/problems/two-sum/",
  "description": "给定一个整数数组 nums 和一个整数目标值 target，请你在该数组中找出和为目标值 target 的那两个整数，并返回它们的数组下标。",
  "language": "cpp",
  "code": "class Solution {\npublic:\n    vector<int> twoSum(vector<int>& nums, int target) {\n        for (int i = 0; i < nums.size(); i++) {\n            for (int j = i + 1; j < nums.size(); j++) {\n                if (nums[i] + nums[j] == target) {\n                    return {i, j};\n                }\n            }\n        }\n        return {};\n    }\n};",
  "mode": "coach"
}
